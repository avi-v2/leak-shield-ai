# Sentinel AI Security Gateway Environment Configuration
APP_ENV=development

# Allowed CORS Origins (comma-separated list of origins for frontend)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# SQLite Database Location
DATABASE_PATH=backend/sentinel.db

# LLM Provider Configuration (Ollama local inference)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=15.0

# Prompt bounds
MAX_PROMPT_LENGTH=20000

# Model Artifact Path
MODEL_ARTIFACT_PATH=backend/models/injection_classifier.json
